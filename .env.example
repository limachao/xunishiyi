# ============================================================
# Database
# ============================================================
# Vercel Postgres / Neon / Supabase / Local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/fitmate?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/fitmate?schema=public"

# ============================================================
# Auth (Auth.js / NextAuth 5)
# ============================================================
AUTH_SECRET="replace-with-random-string-via-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# OAuth Credentials (optional for MVP dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ============================================================
# Storage (S3-compatible: AWS S3 / Cloudflare R2 / Backblaze)
# ============================================================
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="fitmate-uploads"
S3_PUBLIC_BASE_URL="https://cdn.example.com"

# ============================================================
# Payments (Stripe)
# ============================================================
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs (create in Stripe Dashboard first)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=""

# ============================================================
# AI Service (Choose one or both for failover)
# ============================================================
# ---------- 火山引擎 Seedream 5.0 Pro（推荐，V1 主力方案） ----------
# 说明：填入以下 API Key 后，项目会自动启用真实 API；留空则走本地 Mock。
# 文档：https://www.volcengine.com/docs/82379
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=doubao-seedream-5-0-pro-260628
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_TIMEOUT_MS=90000
VOLCENGINE_SIZE=2K

# Provider A: e.g., Virtual Try-On specific API (备用/历史)
AI_PROVIDER_A_ENDPOINT=""
AI_PROVIDER_A_API_KEY=""

# Provider B: backup / failover (备用/历史)
AI_PROVIDER_B_ENDPOINT=""
AI_PROVIDER_B_API_KEY=""

# Clothing category detection (optional — fallback built-in)
CATEGORY_API_ENDPOINT=""
CATEGORY_API_KEY=""

# ============================================================
# Analytics / Monitoring
# ============================================================
NEXT_PUBLIC_MIXPANEL_TOKEN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ============================================================
# App Configuration
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FREE_CREDITS=5
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
